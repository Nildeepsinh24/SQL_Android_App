        padding-right: 1px !important;
    }

    .minify .cdf40d50ba-express-edit-cta-icon img {
        width: 24px;
        height: 24px;
        padding: 0 !important;
    }

    .minify .cdf40d50ba-express-edit-cta-button {
        border: none;
        border-color: #B30B00;
        overflow: hidden;
        background-color: #B30B00;
    }

    .minify .cdf40d50ba-express-expand-menu-icon {
        opacity: 0;
        width: 0;
        height: 0;
        padding: 0;
        margin: 0;
    }

    .minify .cdf40d50ba-express-menu-item-text {
        width: 0;
        margin-left: 0;
        margin-right: 0;
        padding-left: 0;
        padding-right: 0;
        transition: all 300ms ease;
    }

    .minify .cdf40d50ba-express-expand-menu-icon-container {
        opacity: 0;
        width: 0;
        height: 0;
        padding: 0;
        margin: 0;
    }

    .cdf40d50ba-express-edit-cta-button {
        display: flex;
        align-items: center;
        justify-content: center;
        box-sizing: border-box;
        -webkit-box-sizing: border-box;
        -moz-box-sizing: border-box;
        overflow: hidden;
        width: 100%;
        height: 100%;
        border-width: 2px;
        border-radius: 16px;
        border-style: solid;
        border-color: #DADADA;
        transition: all 300ms ease;
    }

    .cdf40d50ba-express-edit-cta-button img {
        width: 18px;
        height: 18px;
        box-sizing: border-box;
        -webkit-box-sizing: border-box;
        -moz-box-sizing: border-box;
    }

    .cdf40d50ba-express-floating-menu {
        position: absolute;
        top: 38px;
        left: calc(100% - 24px);
        display: none;
        flex-direction: column;
        align-items: stretch;
        background: #FFFFFF;
        min-width: 116px;
        padding: 4px 4px;
        transition: all 0.3s ease;
        z-index: 10001;
        border: 1px solid #D5D5D5;
        box-shadow: 0px 4px 12px 0px rgba(0, 0, 0, 0.08), 0px 2px 6px 0px rgba(0, 0, 0, 0.04), 0px 0px 2px 0px rgba(0, 0, 0, 0.12);
        border-radius: 4px;
        gap: 4px;
        box-sizing: border-box;
