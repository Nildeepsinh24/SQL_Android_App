<style>
    .cdf40d50ba-express-hover-cta {
        position: relative;
        width: auto;
        max-width: 1000px;
        height: 32px;
        border-radius: 20px;
        cursor: pointer;
        background-color: #FFFFFF;
        color: #333;
        display: flex;
        align-items: center;
        font-family: "Adobe Clean", adobe-clean, "AdobeClean-Regular", sans-serif !important;
        justify-content: center;
        box-sizing: border-box;
        -webkit-box-sizing: border-box;
        -moz-box-sizing: border-box;
        transition: all 300ms ease;
    }

    .gmailMessageView.minify {
        top: 0;
    }

    .gmailMessageView {
        all: initial;
        top: -4px;
        position: absolute;
        right: 100%;
        padding: 0 !important;
        transition: all 300ms ease;
    }

    .gmailMessageView.minify .cdf40d50ba-express-hover-cta {
        max-width: 25px;
        height: 25px;
        border-radius: 7px;
