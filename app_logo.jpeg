  <div id="express-single-click-cta" class="cc440d50ba-express-entrypoint-button">
    <div class="cc440d50ba-express-entrypoint-button-icon">
      <img class="cc440d50ba-express-entrypoint-button-icon-img" src="chrome-extension://efaidnbmnnnibpcajpcglclefindmkaj/browser/images/acrobat_prodc_appicon_24.svg">
    </div>
    <div id="expressEditImageParentContextMenu" class="cc440d50ba-express-entrypoint-button-text translate">Edit Image</div>
  </div>
